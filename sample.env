NEXT_PUBLIC_MTGCB_API_BASE_URL=http://local.mtgcb.com:5000
# Server-only API base URL for Next.js route handlers (server->API hop).
# In production set this to the Render private-network address (http://mtgcb-api-v3:10000)
# so server-side calls bypass Cloudflare. Falls back to NEXT_PUBLIC_MTGCB_API_BASE_URL when unset.
# MTGCB_API_SERVER_URL=
NEXT_PUBLIC_RECAPTCHA_SITE_KEY=PUBLIC_SITE_KEY
MTGCB_API_PRIVATE_KEY=PRIVATE_KEY
NEXT_PUBLIC_IMAGE_CACHE_DATE=20250301
SENTRY_AUTH_TOKEN=sntrys_...
SENTRY_ORG=brian-chuchua
SENTRY_PROJECT=mtgcb-web-v2
NEXT_PUBLIC_ENABLE_GA=true
NEXT_PUBLIC_GA_MEASUREMENT_ID=G-XXXXXXXX                                     
SENTRY_AUTH_TOKEN=